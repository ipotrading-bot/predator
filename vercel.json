{
  "version": 2,
  "name": "predator-paim",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.py",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      }
    }
  ],
  "functions": {
    "api/scan.py":    { "maxDuration": 60, "memory": 512 },
    "api/signals.py": { "maxDuration": 10, "memory": 256 },
    "api/audit.py":   { "maxDuration": 10, "memory": 256 },
    "api/health.py":  { "maxDuration": 5,  "memory": 128 }
  },
  "crons": [
    { "path": "/api/scan", "schedule": "0 0 * * *" }
  ]
}
