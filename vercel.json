{
  "version": 2,
  "builds": [
    {
      "src": "api/scan.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/scan.py"
    }
  ],
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "0 8 * * *"
    }
  ]
}
