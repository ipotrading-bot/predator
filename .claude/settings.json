{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(python -m pytest *)",
      "Bash(python -m pyflakes *)",
      "Bash(gh run *)",
      "Bash(gh pr *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(python scripts/ops.py doctor*)",
      "Bash(python scripts/ops.py status*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Bash(cat .env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Edit(.python-version)",
      "Edit(requirements.txt)",
      "Edit(requirements-dev.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.github/**)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_workflows.sh",
            "timeout": 10,
            "statusMessage": "Garde workflows (règles n°1 et n°2)..."
          },
          {
            "type": "command",
            "if": "Write(.github/**)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_workflows.sh",
            "timeout": 10,
            "statusMessage": "Garde workflows (règles n°1 et n°2)..."
          },
          {
            "type": "command",
            "if": "Edit(**/*.py)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_ai_models.sh",
            "timeout": 10,
            "statusMessage": "Garde des noms de modèles IA (règle n°3)..."
          },
          {
            "type": "command",
            "if": "Write(**/*.py)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_ai_models.sh",
            "timeout": 10,
            "statusMessage": "Garde des noms de modèles IA (règle n°3)..."
          },
          {
            "type": "command",
            "if": "Edit(core/constants.py)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_operator_decisions.sh",
            "timeout": 10,
            "statusMessage": "Garde des décisions opérateur (règle n°11)..."
          },
          {
            "type": "command",
            "if": "Write(core/constants.py)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_operator_decisions.sh",
            "timeout": 10,
            "statusMessage": "Garde des décisions opérateur (règle n°11)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_bash.sh",
            "timeout": 10,
            "statusMessage": "Garde des commandes shell..."
          }
        ]
      },
      {
        "matcher": "mcp__supabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_supabase_writes.sh",
            "timeout": 10,
            "statusMessage": "Garde Supabase (règle n°9 : archiver, jamais supprimer)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/dashboard_smoketest.sh",
            "async": true,
            "timeout": 30,
            "statusMessage": "Smoke test du dashboard..."
          },
          {
            "type": "command",
            "if": "Edit(**/*.py)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/lint_on_edit.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 120,
            "statusMessage": "pyflakes + tests ciblés..."
          },
          {
            "type": "command",
            "if": "Write(**/*.py)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/lint_on_edit.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 120,
            "statusMessage": "pyflakes + tests ciblés..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/verify_before_stop.sh",
            "timeout": 180,
            "statusMessage": "Suite de tests avant de rendre la main..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session_context.sh",
            "timeout": 15,
            "statusMessage": "Contexte de session (branche, CI)..."
          }
        ]
      }
    ]
  }
}
