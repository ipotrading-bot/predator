{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/dashboard_smoketest.sh",
            "async": true,
            "timeout": 30,
            "statusMessage": "Dashboard smoke test..."
          }
        ]
      }
    ]
  }
}
