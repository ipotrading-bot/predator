{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(python -m pytest *)",
      "Bash(python -m pyflakes *)",
      "Bash(gh run *)",
      "Bash(gh pr *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(python scripts/ops.py doctor*)",
      "Bash(python scripts/ops.py status*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Bash(cat .env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Edit(.python-version)",
      "Edit(requirements.txt)",
      "Edit(requirements-dev.txt)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/dashboard_smoketest.sh",
            "async": true,
            "timeout": 30,
            "statusMessage": "Smoke test du dashboard..."
          }
        ]
      }
    ]
  }
}
