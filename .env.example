BETTERSTACK_TOKEN=
BETTERSTACK_SOURCE_ID=

# ── 10 bis. JETON D'ADMINISTRATION DU DASHBOARD ──────────────────
# AJOUTÉ le 2026-08-22. `POST /api/audit/run` déclenche audit.yml — 45 min
# de runner, le settlement, la réserve IA. Elle était ouverte à tout
# Internet sur une URL Vercel publique, sans cooldown ni limite de débit.
# Elle exige maintenant ce jeton et ÉCHOUE FERMÉ : non renseigné = route
# refusée. À poser dans les variables d'environnement du projet VERCEL
# (pas dans les secrets GitHub : aucun workflow ne le lit).
#   Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Utiliser : curl -X POST .../api/audit/run -H "X-Predator-Token: <jeton>"
DASHBOARD_ADMIN_TOKEN=

# ── 11 bis. BETFAIR EXCHANGE (source sharp — optionnel) ───────────
# AJOUTÉ le 2026-08-22 : ces cinq variables SONT lues (core/harvester.py,
# run_engine.py) mais manquaient à ce fichier. Un opérateur qui copiait
# .env.example n'avait aucun moyen de savoir que la source existait.
# Betfair est OPTIONNEL : sans credentials, harvester saute la source et
# log — il ne crashe pas (politique « retour [] + log » du projet).
# 🌐 developer.betfair.com — l'App Key demande une validation manuelle.
#    Le login par certificat exige un couple PEM (cert + clé privée),
#    à coller ICI en une seule ligne avec des \n littéraux.
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_APP_KEY=
BETFAIR_CERT=
BETFAIR_CERT_KEY=

# ── 11 ter. OUTILLAGE OPÉRATEUR (scripts/ops.py) ─────────────────
# AJOUTÉ le 2026-08-22. CLAUDE.md documente `python scripts/ops.py
# doctor|status|supabase …|vercel …` comme LA façon de piloter la stack,
# et précise « credentials dans .env » — mais ce fichier ne les listait
# pas. La commande documentée était donc inutilisable après une copie
# propre de .env.example.
# Rien de tout cela n'est nécessaire au PIPELINE : ces clés ne servent
# qu'aux gestes manuels d'administration depuis un poste de dev. Ne PAS
# les mettre dans les secrets GitHub.
#
# 🌐 supabase.com/dashboard/account/tokens — Personal Access Token,
#    nécessaire au SQL brut et aux migrations (le service_role ne suffit pas).
SUPABASE_ACCESS_TOKEN=
# Référence du projet Supabase. Défaut codé dans ops.py (cf. .mcp.json) ;
# à renseigner seulement si vous pointez un autre projet.
SUPABASE_PROJECT_REF=
# 🌐 vercel.com/account/tokens
VERCEL_TOKEN=
# Nom ou id du projet Vercel — défaut « predator ». `vercel projects` pour le trouver.
VERCEL_PROJECT=
# Optionnel : uniquement si le projet vit sur un compte d'ÉQUIPE.
VERCEL_TEAM_ID=

# ── 11 quater. PROXY DES SOURCES FILTRÉES PAR IP (core/net.py) ───
#
# odds.500.com n'est PAS en panne : elle est filtrée par IP. Mesuré le
# 2026-08-26 — HTTP 200 et 15 fixtures depuis un poste de développement,
# `Connection refused` depuis les runners GitHub Actions, à chaque run.
# Le code, le parseur et le User-Agent vont bien ; aucune correction de
# code ne lève un blocage d'IP. La seule issue est de router ces requêtes
# par un proxy dont l'IP est acceptée.
#
# TOUT EST OPTIONNEL. Vide = comportement strictement inchangé : aucun
# proxy n'est jamais imposé, et `core/net.py` reste inerte.
#
# Format : http://utilisateur:motdepasse@hote:port  (https:// accepté)
# Résolution : la variable PAR SOURCE gagne sur la globale, et chacune est
# lue par core/secret_store.py — donc `app_secrets` (Supabase) AVANT
# l'environnement. Poser l'URL en base la rend rotative SANS redéploiement
# ni propagation dans les workflows, comme les clés OddsAPI.
#
# Pourquoi une variable par source : 500.com et 7M ne sont pas hébergés au
# même endroit et peuvent très bien ne pas être bloqués ensemble. Au
# 2026-08-26, 7M n'a JAMAIS été appelé depuis un runner — sa joignabilité
# réelle depuis Azure est INCONNUE, pas bonne.
#
# Vérification : `python scripts/ops.py sources` dit, par source, si elle
# répond et si elle passe par un proxy. ⚠️ Un test depuis un poste de
# développement ne prouve RIEN sur les runners : là-bas, ça marche déjà
# sans proxy. Seul un run GitHub Actions tranche.
FREE_SOURCES_PROXY=
ODDS500_PROXY=
SEVENM_PROXY=

# Variante RELAIS (Cloudflare Worker) — le choix retenu le 2026-08-26.
# Un Worker n'est PAS un proxy HTTP (pas de CONNECT) : il refait la requête
# depuis SON adresse et rend la réponse. Déploiement, gardes et procédure de
# vérification : scripts/cloudflare_relay_worker.js (palier gratuit,
# 100 000 req/jour ; odds500 en consomme au plus 400).
# Le relais GAGNE sur le proxy si les deux sont renseignés.
# ⚠️ Le JETON n'est pas optionnel : sans lui le Worker est un proxy ouvert,
# que le premier venu utilisera sur votre quota. Il doit valoir exactement le
# secret `RELAY_TOKEN` posé côté Worker (`wrangler secret put RELAY_TOKEN`).
FREE_SOURCES_RELAY=
FREE_SOURCES_RELAY_TOKEN=
ODDS500_RELAY=
SEVENM_RELAY=

# ── 12. PARAMÈTRES PAIM ───────────────────────────────────────────
# ⚠️ Les défauts vivent dans core/constants.py (KELLY_FRACTION, TAX_RATE,
#    …) et les seuils d'edge dans Supabase meta.threshold_<sport>
#    (pilotés par core/learning_layer.py). AUCUNE variable d'env de type
#    MIN_EV_THRESHOLD / STARTING_BANKROLL n'est lue — le config.py qui les
#    lisait n'existe plus. Modifier core/constants.py, pas ce fichier.

