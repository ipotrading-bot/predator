# PREDATOR PAIM v2.0 — Environment Variables
# Copy this file to .env and fill in your values

# ── Required API Keys ─────────────────────────────────────────────
# The-Odds API for odds data
ODDS_API_KEY=your_odds_api_key_here

# Google Gemini AI for deep analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API for ultra-fast signal filtering (optional but recommended)
GROQ_API_KEY=your_groq_api_key_here

# News API for sports news ingestion (optional)
NEWS_API_KEY=your_news_api_key_here

# ── Supabase Database ────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Telegram Notifications ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_or_channel_id

# ── Dashboard Security (optional) ────────────────────────────────
PREDATOR_SECRET=your_secret_key_for_api_auth

# ── BetterStack Logging (optional) ───────────────────────────────
# Get from https://betterstack.com/logs
BETTERSTACK_TOKEN=your_betterstack_token
BETTERSTACK_SOURCE_ID=your_source_id

# ── 1XBet Configuration (optional) ───────────────────────────────
XBET_BASE_URL=https://1xbet.com/en/line/

# ── PAIM Engine Settings (optional - has defaults) ───────────────
# MIN_EV_THRESHOLD=0.08
# MIN_SNR_RATIO=1.5
# KELLY_FRACTION=0.25
# MAX_DRAWDOWN_PCT=0.15
# STARTING_BANKROLL=10000

# ── Groq Model (optional - has default) ──────────────────────────
# GROQ_MODEL=llama-3.1-70b-versatile

# ── Gemini Model (optional - has default) ────────────────────────
# GEMINI_MODEL=gemini-2.0-flash-exp