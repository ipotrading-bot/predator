# ═══════════════════════════════════════════════════════════════════
# PREDATOR PAIM — CLÉS API / SECRETS / CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
#
# 📌 COMMENT REMPLIR :
#   1. Copiez ce fichier en .env
#   2. Inscrivez vos vraies clés (sans guillemets)
#   3. Le .env est dans .gitignore → jamais commité
#
# 🔐 POUR GITHUB ACTIONS :
#   Copiez chaque clé dans Settings → Secrets and variables → Actions
#   Noms exacts (en MAJUSCULES) : GROQ_API_KEY, TAVILY_API_KEY, SUPABASE_URL, SUPABASE_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#   Wiz v10.0 (optionnel, domaine de panne séparé) : MISTRAL_API_KEY
#
# ═══════════════════════════════════════════════════════════════════

# ── 1. THE ODDS API (source principale de cotes) ─────────────────
# 🌐 Site : the-odds-api.com
# 💡 Usage : Cotes en temps réel (500 req/mois gratuits — une clé dure
#    ~2 jours au rythme de scan actuel).
#
# ⚠️ POOL DE CLÉS (v10.3, depuis l'incident 10→20 août 2026 : clé unique à
#    0 crédit jamais tournée = dix jours sans un seul signal). Le moteur lit
#    ODDS_API_KEYS (plusieurs clés, séparées par virgule) PUIS ODDS_API_KEY ;
#    une clé épuisée est écartée automatiquement et le scan continue sur la
#    suivante. Mettez-en 3-4 (3-4 comptes gratuits) et oubliez la rotation.
#    Source de vérité : app_secrets (Supabase) → `python scripts/rotate_odds_key.py --add <clé>`.
#    Le secret GitHub ODDS_API_KEY doit rester NON VIDE (préflight des workflows).
ODDS_API_KEYS=
ODDS_API_KEY=

# ── 1 bis. PÉRIMÈTRE SPORTS & POLITIQUE DE DÉPENSE (2026-08-22) ───
# 💡 Plus aucun sport pricé par recherche web : eSports / tennis de table /
#    volley / handball sont RETIRÉS (core/constants.RETIRED_SPORTS) ; MMA,
#    boxe, NFL, LdC/UEL, Euroleague arrivent par le flux OddsAPI réel et ne
#    coûtent rien tant que le pré-vol (0 crédit) ne trouve aucun match.
#
# NFL : pas de scan de PRÉSAISON (lignes molles). Date d'ouverture de la
# saison régulière, lue par core/odds_api.SEASON_OPENS — avant, 0 appel.
NFL_SEASON_START=2026-09-10
#
# Politique de dépense OddsAPI (core/scan_windows.py) : hors fenêtre
# favorable, jamais deux scans payants de la même ligue à moins de N minutes ;
# sous la réserve de crédits, les scans de fond s'espacent seuls (fenêtres
# favorables et capture de closing line toujours payées). Chaque ligue sautée
# est loggée « DÉPENSE | … » — aucune réduction silencieuse.
BACKGROUND_MIN_INTERVAL_MIN=180
ODDS_API_RESERVE_CREDITS=60
#
# Mode REPRICE (step horaire de golden_hour.yml, gratuit) : TTL du slate soft
# photographié par les scans complets, et dédup Telegram des systèmes.
CACHE_SOFT_SLATE_TTL_H=4
SYSTEM_ALERT_TTL_H=6

# ── 2. API-SPORTS (foot / basket / baseball / hockey) ─────────────
# 🌐 Site : api-sports.io (dashboard.api-football.com) → compte gratuit
#
# ⭐ SOURCE DE REPLI PRINCIPALE depuis l'incident du 10→20 août 2026. La
#    raison est structurelle : elle authentifie par CLÉ, donc elle ne filtre
#    pas par IP. Tout ce qui s'atteint SANS clé est bloqué depuis les runners
#    GitHub (vérifié le 2026-08-20) — LineFeed 1xbet/Melbet en timeout, ESPN
#    403 Akamai, SofaScore 403. Les 4 hôtes api-sports répondent, eux.
#
# 💡 UNE CLÉ, QUATRE SPORTS : le même compte donne accès à
#    v3.football / v1.basketball / v1.baseball / v1.hockey .api-sports.io,
#    chacun avec SON quota gratuit de 100 requêtes/jour (il faut activer
#    chaque sport une fois dans le dashboard). Mettre la clé dans
#    API_SPORTS_KEY débloque les quatre d'un coup.
#    Lu par core/api_sports.py ; branché en Tier 2 via core/harvester.py.
#    Un cycle coûte ≤ 7 requêtes par sport (cotes par DATE, paginées).
#
# 🎯 Ces réponses contiennent parfois PINNACLE : dans ce cas le moteur a le
#    prix sharp ET le prix soft dans le même appel, et produit un signal
#    SANS aucune recherche web (donc sans dépendre de Groq/Tavily).
#
# ✅ RECOMMANDÉ : poser la clé dans Supabase `app_secrets` plutôt qu'ici —
#    core/secret_store.py la lit AVANT l'environnement, donc elle prend effet
#    sur le moteur ET le dashboard sans redéploiement et sans secret GitHub :
#      python scripts/ops.py supabase secrets set API_SPORTS_KEY <clé>
API_SPORTS_KEY=
# Surcharges par sport (inutiles si les 4 vivent sur le même compte) :
# API_FOOTBALL_KEY=   (prioritaire pour le foot — nom historique, toujours lu)
# API_BASKETBALL_KEY=
# API_BASEBALL_KEY=
# API_HOCKEY_KEY=
API_FOOTBALL_KEY=

# RAPIDAPI_KEY ⚠️ UNUSED — vérifié par grep (2026-08-20) : aucun fichier .py
#   ne le lit. Conservé au cas où un secret GitHub existant porte ce nom.
RAPIDAPI_KEY=

# ── 2 bis. ODDS-API.IO (books SOFT : 1xbet, Bet365, Winamax…) ────
# 🌐 Site : odds-api.io — inscription par email, SANS carte bancaire
# 💡 Plan gratuit : 100 req/heure, 500/jour, à vie.
#
# ⭐ POURQUOI : le moteur compare une référence sharp au prix d'un book SOFT
#    (historiquement 1xbet via son LineFeed). Ce LineFeed est bloqué depuis
#    les runners GitHub ; odds-api.io redonne accès aux MÊMES books par une
#    voie authentifiée et licenciée. Fournit h2h + spreads + totals, soit
#    les trois marchés du moteur. Lu par core/odds_api_io.py.
#
# 💰 COÛT : les cotes se prennent par lot de 10 événements
#    (`/v3/odds/multi`), donc ~5 requêtes par scan. Le compteur partagé de
#    core/daily_quota.py fait respecter ODDS_API_IO_DAILY_BUDGET (400).
#
# ⚙️  Le plan limite le nombre de bookmakers ACTIFS simultanément. Le compte
#    est interrogé à l'exécution ; ODDS_API_IO_BOOKMAKERS (CSV) force la
#    liste et économise cette requête. Sélectionner un exchange (Betfair
#    Exchange) donnerait en plus un prix SHARP dans la même réponse.
#
# ✅ De préférence dans Supabase app_secrets, comme les autres :
#      python scripts/ops.py supabase secrets set ODDS_API_IO_KEY <clé>
ODDS_API_IO_KEY=
# ODDS_API_IO_BOOKMAKERS=1xbet
# ODDS_API_IO_DAILY_BUDGET=400

# ── 3. GROQ (IA + recherche web — REMPLACE Gemini depuis 2026-07-21) ──
# 🌐 Site : console.groq.com (gratuit, pas de carte)
# 💡 Usage : cœur IA du pipeline (core/ai_search.py). Utilisé pour :
#   - MMA / eSports / sports alternatifs (core/harvester.py)
#   - Settlement — score final des matchs (core/settlement.py)
#   - Oracle CLV — closing line Pinnacle (core/oracle.py)
#   - Tier 2/3 guerrilla (fetch_pinnacle_prices / fetch_estimated_prices)
# Modèles : groq/compound-mini (recherche web INTÉGRÉE) en premier,
# llama-3.3-70b-versatile / llama-3.1-8b-instant pour l'extraction.
# ⚠️ Sans cette clé, tout ce qui précède retourne [] (pas de crash).
# 📜 Historique : les GEMINI_API_KEY / _AUDIT / _ALT ont été supprimées —
#    le grounding Google Search gratuit de Gemini est mort (limit: 0 sans
#    facturation prépayée, vérifié sur 4 clés/projets le 2026-07-21).
GROQ_API_KEY=

# ── 4. TAVILY (recherche web de secours) ──────────────────────────
# 🌐 Site : app.tavily.com (gratuit, 1 000 recherches/mois)
# 💡 Usage : étage 2 de core/ai_search.py — si groq/compound-mini échoue,
#    Tavily fournit les résultats web et llama-3.3-70b extrait le JSON.
#    Optionnelle mais recommandée (sinon un seul étage de recherche).
#    TAVILY_RUN_BUDGET (défaut 25) plafonne les recherches par run.
TAVILY_API_KEY=

# ── 4bis. ROUTEUR IA MULTI-FOURNISSEURS (mission 4) ───────────────
# TOUTES ces clés sont OPTIONNELLES : une clé absente = fournisseur ignoré
# silencieusement par core/ai_router.py. Zéro dépendance obligatoire.
#
# ⚠️ RÈGLE NON NÉGOCIABLE : **UN SEUL COMPTE PAR FOURNISSEUR**. La capacité
#    vient de la DIVERSITÉ des fournisseurs, jamais de comptes multiples —
#    qui partageraient de toute façon le quota et violeraient les CGU.
#
# ⚠️ LE PAYSAGE CHURNE CHAQUE MOIS. Quotas et modèles constatés en live le
#    2026-08-22 ; ils périmeront. Le routeur découvre les catalogues au
#    démarrage de chaque run et bascule tout seul — ne codez jamais un nom de
#    modèle en dur ailleurs que dans le registre de core/ai_router.py.
#    📜 Morts vérifiés : GitHub Models (HTTP 410, retiré le 2026-07-30) et
#       Cerebras (HTTP 403, palier gratuit sans carte fermé en août 2026).
#       Leurs variables GITHUB_MODELS_TOKEN / CEREBRAS_API_KEY ne sont plus lues.
#
# ── Priorité 1 : palier gratuit permanent, sans carte ──
# 🌐 cloud.cerebras.ai
#    ⚖️ terms_flag=payment_required — TRANCHÉ PAR L'INFÉRENCE le 2026-08-22 :
#       la clé authentifie, le catalogue rend 200 (2 modèles), mais le premier
#       appel d'inférence rend 402 {"code":"payment_required"}. Inutilisable
#       sans carte. Gardé au registre pour ne pas repayer l'enquête.
CEREBRAS_API_KEY=
# 🌐 aistudio.google.com/apikey — Gemini 2.5 Flash / Flash-Lite, palier gratuit.
#    ⚠️ Le GROUNDING Google Search gratuit est MORT (limit:0, vérifié sur 4 clés
#       le 2026-07-21) ; seule la GÉNÉRATION simple survit. Ce fournisseur ne
#       sert donc jamais la lane search_read.
GEMINI_API_KEY=
# 🌐 dash.cloudflare.com → AI → Workers AI — 10 000 neurons/j.
#    ⚠️ Demande AUSSI CLOUDFLARE_ACCOUNT_ID : l'identifiant de compte est dans
#       l'URL. Sans lui, la clé seule est ignorée (et c'est dit dans les logs).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# 🌐 studio.nebius.ai — crédits gratuits à l'inscription (Qwen3, Llama 3.3).
NEBIUS_API_KEY=
# 🌐 chutes.ai — catalogue public, palier gratuit avec quota quotidien.
CHUTES_API_KEY=
# 🌐 openrouter.ai/keys — ~50 req/j (1000/j après un crédit unique de 10 $) ;
#    421 modèles dont 18 en `:free`. Lanes : analyze, filter, translate_cjk.
OPENROUTER_API_KEY=
# 🌐 cloud.sambanova.ai — 7 modèles (Llama 3.3 70B, DeepSeek V3.2, gpt-oss-120b).
#    ⚖️ terms_flag=payment_required — catalogue 200 mais inférence 402
#       {"code":"PAYMENT_METHOD_REQUIRED","balance_units":0}. Carte obligatoire.
SAMBANOVA_API_KEY=
# 🌐 endpoints.ai.cloud.ovh.net — palier gratuit, souveraineté UE ; 24 modèles
#    (Llama 3.3 70B, Qwen3-32B, Mistral). Lanes : filter, analyze, translate_cjk.
OVH_AI_API_KEY=
# 🌐 console.scaleway.com → Generative APIs — palier gratuit, souveraineté UE.
#    Lanes : filter, analyze.
SCALEWAY_API_KEY=
# 🌐 ollama.com/settings/keys — 19 modèles (GLM-5.2, Kimi K3, gpt-oss,
#    DeepSeek V4). 1 requête à la fois, sessions 5 h → réservé aux batches non
#    urgents. Lanes : settlement (filet de nuit), analyze, translate_cjk.
OLLAMA_API_KEY=
# 🌐 build.nvidia.com — ~40 req/min, 102 modèles (DeepSeek V4 Flash, Llama),
#    ~1 000 crédits offerts, sans carte.
#    ⚖️ terms_flag=evaluation — VÉRIFIÉ, pas supposé : NVIDIA réserve ce palier
#       au développement, test, recherche et évaluation ; « servir de vrais
#       utilisateurs » ou « conduire des transactions » relève de la PRODUCTION
#       et exige une licence AI Enterprise. PREDATOR mise de l'argent réel →
#       usage de production → exclu des lanes de production, sans exception.
NVIDIA_NIM_API_KEY=
# 🌐 dashboard.cohere.com — 1 000 appels/mois.
#    ⚖️ terms_flag=non_commercial : USAGE NON COMMERCIAL EXPLICITE → jamais
#       choisi en production, réservé à l'expérimentation.
COHERE_API_KEY=
#
# ── Priorité 2 : Asie — meilleurs modèles pour les noms d'équipes CJK ──
#    (double emploi avec la mission 3 : lane TRANSLATE_CJK du dictionnaire
#     team_aliases — volumes minuscules grâce au cache d'alias)
# 🌐 z.ai / open.bigmodel.cn — GLM-4.7-Flash gratuit, excellent en chinois.
#    ⚖️ terms_flag=non_commercial : carve-out recherche/non-commercial.
ZHIPU_API_KEY=
# 🌐 modelscope.cn (Alibaba) — 46 modèles dont toute la gamme Qwen3 et
#    GLM-4.7-Flash. Qwen = référence pour le chinois. Lanes : translate_cjk, analyze.
MODELSCOPE_API_KEY=
# 🌐 siliconflow.cn — inférence gratuite Qwen & co. Lane : translate_cjk.
SILICONFLOW_API_KEY=
# 🌐 console.upstage.ai — crédits d'essai ; utile ponctuellement pour le coréen.
#    ⚖️ terms_flag=evaluation.
UPSTAGE_API_KEY=
#
# ── Recherche / lecture web (renforts de Tavily) ──
# 🌐 jina.ai/reader — lecture de pages (r.jina.ai) et recherche (s.jina.ai),
#    palier gratuit généreux. r.jina.ai répond même sans clé (200 vérifié).
JINA_API_KEY=
# 🌐 serper.dev — 2 500 requêtes offertes à l'inscription. Dépannage SERP.
SERPER_API_KEY=
# 🌐 serpapi.com — 100 recherches/mois. Dépannage SERP.
SERPAPI_KEY=
#
# ── Réglages du routeur (défauts sûrs, à ne changer qu'à bon escient) ──
# AI_BREAKER_THRESHOLD=3     # échecs consécutifs avant mise au repos
# AI_BREAKER_REST_MIN=30     # durée du repos, en minutes
# AI_LANE_MIN_HEALTHY=2      # sous ce seuil, alerte Telegram sur la lane
# AI_SETTLEMENT_RESERVE=80   # requêtes/jour réservées au settlement — les
#                            # autres lanes n'y ont JAMAIS accès (2026-08-02 :
#                            # le scan avait tout pris, ledger vide 24 h)

# ── 5. SUPABASE (Stockage des signaux) ────────────────────────────
# 🌐 Site : supabase.com
# 💡 Usage : PostgreSQL gratuit (500MB). Stocke :
#   - Signaux validés (table "signals") + historique réglé
#   - Mémoire d'apprentissage (table "ai_learning_ledger")
#   - Seuils/état (table "meta"), secrets (table "app_secrets")
#   - Analyses Wiz (table "wiz_analysis")
#   Schéma : sql/setup_signals.sql + sql/migrate_*.sql (application MANUELLE)
#
# 📌 SUPABASE_URL : https://votre-projet.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# 📌 SUPABASE_KEY : Clé "anon" publique (lecture seule depuis le frontend)
SUPABASE_KEY=your_supabase_anon_key_here
# 📌 SUPABASE_SERVICE_KEY : Clé "service_role" (bypass RLS, écriture)
#    Prioritaire sur SUPABASE_KEY pour les insertions.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── 6. TELEGRAM (Notifications en temps réel) ─────────────────────
# 🌐 BotFather : t.me/BotFather
# 💡 Usage : Envoie les signaux et alertes sur votre téléphone.
#    Créez un bot avec @BotFather, puis récupérez le token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 🌐 UserInfoBot : t.me/userinfobot
# 💡 Usage : Récupérez votre chat_id en envoyant /start au bot.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

