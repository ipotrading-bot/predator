# ═══════════════════════════════════════════════════════════════════
# PREDATOR PAIM — Configuration (.env.example)
# Copiez ce fichier en .env et remplissez vos valeurs.
# ═══════════════════════════════════════════════════════════════════

# ── API Keys (obligatoires) ───────────────────────────────────────
ODDS_API_KEY=your_odds_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Telegram (obligatoire) ────────────────────────────────────────
# Nom de la variable attendu par config.py : TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Supabase (obligatoire) ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── API Keys (optionnelles) ───────────────────────────────────────
GROQ_API_KEY=
NEWS_API_KEY=
PERPLEXITY_API_KEY=
RAPIDAPI_KEY=
API_FOOTBALL_KEY=
HISTORICAL_ODDS_KEY=

# ── Dashboard Security ────────────────────────────────────────────
PREDATOR_SECRET=

# ── BetterStack Logging (optionnel) ──────────────────────────────
BETTERSTACK_TOKEN=
BETTERSTACK_SOURCE_ID=

# ── Paramètres PAIM (optionnels — valeurs par défaut dans config.py) ─
# MIN_EV_THRESHOLD=0.01
# KELLY_FRACTION=0.25
# STARTING_BANKROLL=10000
