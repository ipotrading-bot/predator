# ═══════════════════════════════════════════════════════════════════
# PREDATOR PAIM v7.0 — CLIÉS API / SECRETS / CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
#
# 📌 COMMENT REMPLIR :
#   1. Copiez ce fichier en .env
#   2. Inscrivez vos vraies clés (sans guillemets)
#   3. Le .env est dans .gitignore → jamais commité
#
# 🔐 POUR GITHUB ACTIONS :
#   Copiez chaque clé dans Settings → Secrets and variables → Actions
#   Noms exacts (en MAJUSCULES) : GROQ_API_KEY, TAVILY_API_KEY, SUPABASE_URL, SUPABASE_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#
# ═══════════════════════════════════════════════════════════════════

# ── 1. THE ODDS API (source principale de cotes) ─────────────────
# 🌐 Site : the-odds-api.com
# 💡 Usage : Cotes en temps réel (500 req/mois gratuits).
ODDS_API_KEY=

# ── 2. RAPIDAPI / API-FOOTBALL ────────────────────────────────────
# RAPIDAPI_KEY ⚠️ UNUSED — vérifié par grep (2026-07-11) : aucun fichier
#   .py ne le lit. Conservé au cas où un secret GitHub existant porte déjà
#   ce nom ; ne pas configurer pour un nouveau déploiement.
#
# API_FOOTBALL_KEY — source foot additionnelle, lue par core/api_football.py
#   depuis le 2026-07-21. S'ajoute à The Odds API (core/odds_api.py) comme
#   book de plus dans le Tier 2 (core/harvester.py::_fetch_multi_book) —
#   fournisseur indépendant, pas soumis à la même panne/quota qu'OddsAPI.
# 🌐 Site : api-football.com (ou dashboard.api-football.com) → compte gratuit
# 💡 Plan gratuit : 100 requêtes/jour. Sans cette clé, la fonction retourne
#    [] silencieusement (pas de crash) — comportement identique aux autres
#    sources optionnelles de ce fichier.
RAPIDAPI_KEY=
API_FOOTBALL_KEY=

# ── 3. GROQ (IA + recherche web — REMPLACE Gemini depuis 2026-07-21) ──
# 🌐 Site : console.groq.com (gratuit, pas de carte)
# 💡 Usage : cœur IA du pipeline (core/ai_search.py). Utilisé pour :
#   - MMA / eSports / sports alternatifs (core/harvester.py)
#   - Settlement — score final des matchs (core/settlement.py)
#   - Oracle CLV — closing line Pinnacle (core/oracle.py)
#   - Tier 2/3 guerrilla (fetch_pinnacle_prices / fetch_estimated_prices)
# Modèles : groq/compound-mini (recherche web INTÉGRÉE) en premier,
# llama-3.3-70b-versatile / llama-3.1-8b-instant pour l'extraction.
# ⚠️ Sans cette clé, tout ce qui précède retourne [] (pas de crash).
# 📜 Historique : les GEMINI_API_KEY / _AUDIT / _ALT ont été supprimées —
#    le grounding Google Search gratuit de Gemini est mort (limit: 0 sans
#    facturation prépayée, vérifié sur 4 clés/projets le 2026-07-21).
GROQ_API_KEY=

# ── 4. TAVILY (recherche web de secours) ──────────────────────────
# 🌐 Site : app.tavily.com (gratuit, 1 000 recherches/mois)
# 💡 Usage : étage 2 de core/ai_search.py — si groq/compound-mini échoue,
#    Tavily fournit les résultats web et llama-3.3-70b extrait le JSON.
#    Optionnelle mais recommandée (sinon un seul étage de recherche).
#    TAVILY_RUN_BUDGET (défaut 25) plafonne les recherches par run.
TAVILY_API_KEY=

# ── 5. SUPABASE (Stockage des signaux) ────────────────────────────
# 🌐 Site : supabase.com
# 💡 Usage : PostgreSQL gratuit (500MB). Stocke :
#   - Signaux d'arbitrage validés (table "signals")
#   - Logs de scan (table "scan_logs")
#   - État de rotation (table "scanner_state")
#   - Historique Alpha Decay (table "alpha_decay_history")
#
# 📌 SUPABASE_URL : https://votre-projet.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# 📌 SUPABASE_KEY : Clé "anon" publique (lecture seule depuis le frontend)
SUPABASE_KEY=your_supabase_anon_key_here
# 📌 SUPABASE_SERVICE_KEY : Clé "service_role" (bypass RLS, écriture)
#    Prioritaire sur SUPABASE_KEY pour les insertions.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── 6. TELEGRAM (Notifications en temps réel) ─────────────────────
# 🌐 BotFather : t.me/BotFather
# 💡 Usage : Envoie les signaux et alertes sur votre téléphone.
#    Créez un bot avec @BotFather, puis récupérez le token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 🌐 UserInfoBot : t.me/userinfobot
# 💡 Usage : Récupérez votre chat_id en envoyant /start au bot.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── 7. NEWS API (Filtre contexte — optionnel) ─────────────────────
# 🌐 Site : newsapi.org
# 💡 Usage : 100 req/jour gratuits. Détecte les blessures/transferts.
#    Si une news majeure impacte un match, le signal est rejeté.
NEWS_API_KEY=

# ── 8. PERPLEXITY (Vérification factuelle — optionnel) ───────────
# ⚠️ UNUSED — vérifié par grep sur tout le repo (2026-07-11) : aucun
#    fichier .py ne lit PERPLEXITY_API_KEY. Ne pas configurer.
# 🌐 Site : perplexity.ai
PERPLEXITY_API_KEY=

# ── 9. HISTORICAL ODDS (Données historiques — optionnel) ─────────
# ⚠️ UNUSED — vérifié par grep sur tout le repo (2026-07-11) : aucun
#    fichier .py ne lit HISTORICAL_ODDS_KEY. Ne pas configurer.
# 🌐 Site : the-odds-api.com (plan payant)
HISTORICAL_ODDS_KEY=

# ── 10. API SECRET (Sécurité du pipeline — optionnel) ────────────
# 💡 Usage : Clé personnelle pour protéger les endpoints sensibles.
#    Utilisée comme PREDATOR_SECRET dans config.py
PREDATOR_SECRET=
API_SECRET_KEY=
# 🌐 GITHUB PAT (déclenchement du scan depuis le dashboard)
# Créer sur github.com/settings/tokens → Fine-grained → repo: ipotrading-bot/predator → Actions: write
GITHUB_PAT=

# ── 11. BETTERSTACK (Logging cloud — optionnel) ──────────────────
# 🌐 Site : betterstack.com
# 💡 Usage : Centralisation des logs (alternative à Vercel logs).
BETTERSTACK_TOKEN=
BETTERSTACK_SOURCE_ID=

# ── 12. PARAMÈTRES PAIM (Valeurs par défaut dans config.py) ─────
# 💡 Optionnel : ne décommmenter que pour surcharger les défauts.
# MIN_EV_THRESHOLD=0.010        # Seuil minimum d'EV+ (1.0%)
# KELLY_FRACTION=0.25            # Fraction de Kelly (25%)
# MAX_SINGLE_STAKE_PCT=0.03     # Mise max par pari (3%)
# STARTING_BANKROLL=10000        # Bankroll initiale (10 000€)
# MAX_DRAWDOWN_PCT=0.15          # Stop-loss (15%)
# SYSTEM_SIZE=9                  # Taille du système 7/9
# SYSTEM_MIN_WINS=7              # Victoires minimum pour ticket

# ═══════════════════════════════════════════════════════════════════
