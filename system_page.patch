+// Scénarios COMPLETS : simples + combiné + système ADDITIONNÉS, pour
+// k = 0..N sélections gagnantes. Pire et meilleur cas EXACTS : toutes les
+// parties de k gagnantes sont parcourues (kCombinations). Le retour de
+// chaque combinaison du système vient de comboReturnFactor sur des jambes
+// « won », évalué UNE fois par combinaison ; une combinaison compte ensuite
+// dans un scénario si toutes ses jambes y sont gagnantes (masque de bits) —
+// même résultat qu'un appel de systemReturn par scénario, sans le coût
+// 2^N × 2^N qui gelait la page à N = 10. Retours conditionnels, jamais des
+// probabilités (règle 7). simpleStakes : mise par sélection (index aligné) ;
+// flags : { sys, simples, combo }.
+// Rend [{ k, mise, worst, best }] ; worst/best = { total, sys, simples,
+// combo, indices } où indices sont les gagnantes du cas. [] si N = 0.
+function scenariosComplets(selections, m, lineStake, simpleStakes, comboStake, flags) {
+  const n = selections.length;
+  if (n === 0) return [];
+  const idx = selections.map((_, i) => i);
+  const won = idx.map((i) => ({ odds: Number(selections[i].odds) || 1.01, status: "won" }));
+  const maskOf = (ind) => ind.reduce((acc, i) => acc | (1 << i), 0);
+  const sysCombos = [];
+  if (flags.sys) {
+    for (let j = Math.max(1, Math.min(m, n)); j <= n; j++) {
+      for (const ind of kCombinations(idx, j)) {
+        sysCombos.push({ mask: maskOf(ind), R: comboReturnFactor(ind.map((i) => won[i])) });
+      }
+    }
+  }
+  const simpleR = idx.map((i) => comboReturnFactor([won[i]]));
+  const comboR = comboReturnFactor(won);
+  const mise = sysCombos.length * lineStake
+    + (flags.simples ? simpleStakes.reduce((s, v) => s + (Number(v) || 0), 0) : 0)
+    + (flags.combo ? comboStake : 0);
+  const out = [];
+  for (let k = 0; k <= n; k++) {
+    let worst = null;
+    let best = null;
+    for (const win of kCombinations(idx, k)) {
+      const mask = maskOf(win);
+      let sys = 0;
+      for (const c of sysCombos) if ((c.mask & mask) === c.mask) sys += c.R * lineStake;
+      let simples = 0;
+      if (flags.simples) for (const i of win) simples += simpleR[i] * (Number(simpleStakes[i]) || 0);
+      const combo = flags.combo && k === n ? comboR * comboStake : 0;
+      const r = { total: sys + simples + combo, sys, simples, combo, indices: win };
+      if (!worst || r.total < worst.total - 1e-9) worst = r;
+      if (!best || r.total > best.total + 1e-9) best = r;
+    }
+    out.push({ k, mise, worst, best });
+  }
+  return out;
+}
+
+// Point mort GLOBAL : plus petit k dont le pire cas complet couvre la mise
+// engagée, toutes sections actives confondues. Même contrat que breakEven.
+function breakEvenComplet(scen) {
+  if (!scen || scen.length === 0) return null;
+  const hit = scen.find((sc) => sc.worst.total >= sc.mise - 1e-9);
+  if (!hit) return null;
+  return { k: hit.k, tooShort: hit.k === scen.length - 1 };
+}
