+// Nombre de lignes d'un palier k sur n (C(n, k)) — pour dériver la mise par
+// ligne d'une mise TOTALE sans énumérer les combinaisons.
+function binom(n, k) {
+  if (k < 0 || k > n) return 0;
+  let r = 1;
+  for (let i = 1; i <= k; i++) r = (r * (n - k + i)) / i;
+  return Math.round(r);
+}
 
